# Gateway root, no /v1. Provider keys are configured in Bifrost, not agent environments.
BIFROST_BASE_URL=http://127.0.0.1:8080
BIFROST_API_KEY=
BIFROST_MODEL=openai/gpt-4o-mini
# Optional separately issued admin login/session token for GET /api/logs. Not an inference virtual key.
BIFROST_ADMIN_API_KEY=
BIFROST_LOGS_TIMEOUT_SECONDS=3
TAVILY_API_KEY=
HARNESS_BASE_URL=http://127.0.0.1:8017
DOCKER_HARNESS_BASE_URL=http://host.docker.internal:8017
# Optional explicit USD prices; absent means unknown, never zero.
# INPUT_PRICE_PER_MILLION=0.0
# OUTPUT_PRICE_PER_MILLION=0.0
# TAVILY_CREDIT_PRICE_USD=0.0
# DEFAULT_MAX_COST_USD=0.50
MAX_MODEL_CALLS=12
MAX_SEARCH_CALLS=12
MAX_CONCURRENT_RUNS=3
MAX_EXPERIMENT_RUNS=600
MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_SECONDS=24
TOOL_TIMEOUT_SECONDS=10

# Optional: model for the tier-3 rubric judge (defaults to BIFROST_MODEL)
JUDGE_MODEL=
# Optional, for live M4 gateway failover: a model routed to a failing provider, and the fallback to serve it
OUTAGE_PRIMARY_MODEL=
FALLBACK_MODEL=
